# Copy this file to `.env` and adjust values for your local/dev environment.
# NEVER commit a real `.env` file with production secrets — it is already
# excluded via .gitignore.

APP_NAME="Athlete Biometrics Secure Cloud Server"
ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

MOCK_DB_PATH=mock_db.json

# Shared-secret required via the `X-API-Key` header for /ingest and
# /authorize-decrypt. Generate a strong random value for real deployments, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLOUD_API_KEY=dev-only-insecure-change-me

MAX_PACKET_AGE_SECONDS=300
